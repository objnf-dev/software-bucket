{
    "version": "2026.11.29",
    "description": "An open-source automation assistant for Honkai: Star Rail",
    "homepage": "https://github.com/moesnow/March7thAssistant",
    "license": "GPL-3.0-only",
    "notes": [
        "Use 'scoop update march7thassistant' instead of the built-in updater.",
        "Local game automation requires the Simplified Chinese PC client running at 1920x1080. Running tasks may request administrator privileges."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/moesnow/March7thAssistant/releases/download/v2026.11.29/March7thAssistant_full.7z",
            "hash": "f821353f0e20e035673d62c677900d43da27330a3a3c30213d628bb94b362bac",
            "extract_dir": "March7thAssistant_full"
        }
    },
    "bin": "m7a.exe",
    "shortcuts": [
        [
            "March7th Launcher.exe",
            "March7th Assistant"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path \"$persist_dir\\config.yaml\")) { Copy-Item \"$dir\\assets\\config\\config.example.yaml\" \"$dir\\config.yaml\" }",
        "foreach ($file in 'warp.json', 'characters.json') {",
        "    if (-not (Test-Path \"$persist_dir\\$file\")) { New-Item -ItemType File -Path \"$dir\\$file\" | Out-Null }",
        "}"
    ],
    "persist": [
        "config.yaml",
        "config",
        "settings",
        "logs",
        "screenshots",
        "warp.json",
        "characters.json",
        "3rdparty/WebBrowser/UserProfile",
        "userdata"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moesnow/March7thAssistant/releases/download/v$version/March7thAssistant_full.7z"
            }
        }
    }
}
